# Web search API key for live knowledge retrieval (Stage 0.75).
# Provider is set in config/live_retrieval_config.yaml: search_provider=tavily (default) or serpapi.
LIVE_SEARCH_API_KEY=your-tavily-or-serpapi-key-here

# Groq API key for live page summarization (Stage 0.9).
# Uses the OpenAI-compatible Groq endpoint; model is set in config/live_retrieval_config.yaml (llm_model).
# Get a key at https://console.groq.com
LLM_API_KEY=your-groq-api-key-here

# Optional: override the LLM API base URL (default from config/live_retrieval_config.yaml).
LLM_API_BASE=https://api.groq.com/openai/v1
